# 4. API 設計（DBなし）

## 4.1 GA4 API

* パス：`/api/ga4`
* メソッド：`POST`
* 役割：

  * クライアントから受け取った条件（期間・metrics・dimensions・filters）を元に、GA4 Data API の `runReport` を呼ぶ。
  * 結果をフロントで扱いやすい JSON に整形して返す。

### リクエスト例

```json
{
  "dateRange": {
    "startDate": "2025-10-16",
    "endDate": "2025-11-14"
  },
  "metrics": ["sessions", "conversions"],
  "dimensions": ["date"],
  "filters": [
    {
      "field": "sessionDefaultChannelGroup",
      "operator": "EXACT",
      "value": "Organic Search"
    }
  ]
}
```

### レスポンス例

```json
{
  "rows": [
    { "date": "2025-10-16", "sessions": 123, "conversions": 4 },
    { "date": "2025-10-17", "sessions": 200, "conversions": 8 }
  ]
}
```

### 実装イメージ（`src/app/api/ga4/route.ts`）

```ts
import { NextRequest, NextResponse } from 'next/server';
import { BetaAnalyticsDataClient } from '@google-analytics/data';

const client = new BetaAnalyticsDataClient({
  credentials: {
    client_email: process.env.GOOGLE_CLIENT_EMAIL,
    private_key: process.env.GOOGLE_PRIVATE_KEY?.replace(/\\n/g, '\n'),
  },
});

export async function POST(req: NextRequest) {
  try {
    const body = await req.json();
    const { dateRange, metrics, dimensions, filters } = body;

    const [response] = await client.runReport({
      property: `properties/${process.env.GA4_PROPERTY_ID}`,
      dateRanges: [
        {
          startDate: dateRange.startDate,
          endDate: dateRange.endDate,
        },
      ],
      metrics: metrics.map((m: string) => ({ name: m })),
      dimensions: dimensions.map((d: string) => ({ name: d })),
      dimensionFilter: filters
        ? {
            andGroup: {
              expressions: filters.map((f: any) => ({
                filter: {
                  fieldName: f.field,
                  stringFilter: {
                    matchType: 'EXACT',
                    value: f.value,
                  },
                },
              })),
            },
          }
        : undefined,
    });

    const rows =
      response.rows?.map((row) => {
        const dim: Record<string, string> = {};
        row.dimensionValues?.forEach((v, i) => {
          dim[dimensions[i]] = v.value ?? '';
        });

        const met: Record<string, number> = {};
        row.metricValues?.forEach((v, i) => {
          met[metrics[i]] = Number(v.value ?? 0);
        });

        return { ...dim, ...met };
      }) ?? [];

    return NextResponse.json({ rows });
  } catch (e) {
    console.error(e);
    return NextResponse.json({ error: 'GA4 request failed' }, { status: 500 });
  }
}
```

